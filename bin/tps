#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

TPS_HOME="${TPS_HOME:-$HOME/.termux-public-server}"
PORT="${TPS_PORT:-8080}"
PID_FILE="$TPS_HOME/run/server.pid"
TUNNEL_PID_FILE="$TPS_HOME/run/tunnel.pid"
ADMIN_PID_FILE="$TPS_HOME/run/admin.pid"
LOG_FILE="$TPS_HOME/logs/tps.log"
URL_FILE="$TPS_HOME/run/public-url"
WWW_DIR="$TPS_HOME/www"
SESSION="tps-server"
ADMIN_SESSION="tps-admin"
SELF="${TPS_SELF:-${PREFIX:-}/bin/tps}"
mkdir -p "$TPS_HOME/run" "$TPS_HOME/logs" "$WWW_DIR"

log(){ printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG_FILE"; }
running(){ [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null; }
stop_pid(){ local f="$1"; if running "$f"; then kill "$(cat "$f")" 2>/dev/null || true; fi; rm -f "$f"; }
tmux_running(){ command -v tmux >/dev/null 2>&1 && tmux has-session -t "$1" 2>/dev/null; }

install_cloudflared(){
  if command -v cloudflared >/dev/null 2>&1; then CLOUDFLARED="$(command -v cloudflared)"; return; fi
  local arch url tmp
  arch="$(uname -m)"
  case "$arch" in
    aarch64|arm64) url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64";;
    armv7l|armv6l) url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm";;
    x86_64|amd64) url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64";;
    i686|x86) url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-386";;
    *) echo "Arsitektur tidak didukung: $arch" >&2; exit 1;;
  esac
  tmp="$TPS_HOME/run/cloudflared"
  log "Mengunduh cloudflared untuk $arch ..."
  curl -fL --retry 3 "$url" -o "$tmp"
  chmod 755 "$tmp"
  CLOUDFLARED="$tmp"
}

start_server(){
  if running "$PID_FILE"; then log "Server sudah berjalan (PID $(cat "$PID_FILE"))"; return; fi
  : > "$LOG_FILE"
  if [[ -n "${TPS_APP_COMMAND:-}" ]]; then
    bash -lc "$TPS_APP_COMMAND" >>"$LOG_FILE" 2>&1 &
  else
    python "$TPS_HOME/app.py" --public --port "$PORT" --bind "${TPS_BIND:-127.0.0.1}" >>"$LOG_FILE" 2>&1 &
  fi
  echo $! > "$PID_FILE"
  sleep 1
  if ! running "$PID_FILE"; then log "Server gagal dimulai; lihat $LOG_FILE"; rm -f "$PID_FILE"; exit 1; fi
  log "Server berjalan pada port $PORT (PID $(cat "$PID_FILE")); access key diperlukan."
}

start_foreground(){
  local mode="$1"
  case "$mode" in
    --public)
      PORT="${TPS_PORT:-8080}"
      start_server
      install_cloudflared
      stop_pid "$TUNNEL_PID_FILE"
      rm -f "$URL_FILE"
      "$CLOUDFLARED" tunnel --no-autoupdate --url "http://127.0.0.1:$PORT" 2>&1 | while IFS= read -r line; do
        printf '%s\n' "$line" >> "$LOG_FILE"
        if [[ "$line" =~ https://[-a-zA-Z0-9]+\.trycloudflare\.com ]]; then
          printf '%s\n' "${BASH_REMATCH[0]}" | tee "$URL_FILE"
        fi
      done &
      echo $! > "$TUNNEL_PID_FILE"
      log "Quick Tunnel dimulai. URL publik akan disimpan di $URL_FILE."
      ;;
    --lan)
      PORT="${TPS_PORT:-8080}"
      TPS_BIND="0.0.0.0" start_server
      local ip
      ip="$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
      log "Akses LAN: http://${ip:-IP-TERMUX}:$PORT (access key diperlukan)"
      ;;
    *) echo "Gunakan: tps start --public|--lan [--foreground]" >&2; exit 2;;
  esac
}

cmd_start(){
  local mode="${1:---public}" foreground="${2:-}"
  if [[ "$foreground" != "--foreground" ]]; then
    if ! command -v tmux >/dev/null 2>&1; then echo "tmux belum terpasang. Jalankan: pkg install -y tmux" >&2; exit 1; fi
    if tmux_running "$SESSION"; then echo "Server sudah berjalan di background. Gunakan 'tps status' atau 'tps stop'."; return; fi
    if command -v termux-wake-lock >/dev/null 2>&1; then termux-wake-lock || true; fi
    tmux new-session -d -s "$SESSION" "$SELF start $mode --foreground"
    echo "Server berjalan di background dan dilindungi access key."
    echo "Gunakan 'tps status' untuk URL, 'tps key show' untuk key, dan 'tps admin' untuk halaman pembuat key."
    return
  fi
  start_foreground "$mode"
}

cmd_admin(){
  local foreground="${1:-}"
  if [[ "$foreground" != "--foreground" ]]; then
    if ! command -v tmux >/dev/null 2>&1; then echo "tmux belum terpasang. Jalankan: pkg install -y tmux" >&2; exit 1; fi
    if tmux_running "$ADMIN_SESSION"; then echo "Admin sudah berjalan di http://127.0.0.1:8090"; return; fi
    tmux new-session -d -s "$ADMIN_SESSION" "$SELF admin --foreground"
    echo "Halaman admin key: http://127.0.0.1:8090"
    echo "Halaman ini hanya dapat dibuka dari perangkat Termux dan tidak diekspos ke tunnel."
  else
    python "$TPS_HOME/app.py" --admin --bind 127.0.0.1 --port "${TPS_ADMIN_PORT:-8090}" >>"$LOG_FILE" 2>&1 &
    echo $! > "$ADMIN_PID_FILE"
    wait "$!"
  fi
}

stop_public(){
  if tmux_running "$SESSION"; then tmux kill-session -t "$SESSION" 2>/dev/null || true; fi
  stop_pid "$TUNNEL_PID_FILE"; stop_pid "$PID_FILE"
  if command -v termux-wake-unlock >/dev/null 2>&1; then termux-wake-unlock || true; fi
  rm -f "$URL_FILE"
  log "Server publik dihentikan."
}

stop_admin(){
  if tmux_running "$ADMIN_SESSION"; then tmux kill-session -t "$ADMIN_SESSION" 2>/dev/null || true; fi
  stop_pid "$ADMIN_PID_FILE"
  log "Admin dihentikan."
}

case "${1:-help}" in
  start) cmd_start "${2:---public}" "${3:-}";;
  admin) cmd_admin "${2:-}";;
  key)
    case "${2:-show}" in
      generate) python "$TPS_HOME/app.py" --generate-key; echo "Key baru dibuat dan key lama tidak berlaku.";;
      show) [[ -f "$TPS_HOME/run/access.key" ]] || python "$TPS_HOME/app.py" --generate-key >/dev/null; cat "$TPS_HOME/run/access.key";;
      *) echo "Gunakan: tps key show|generate" >&2; exit 2;;
    esac;;
  public-stop) stop_public;;
  admin-stop) stop_admin;;
  public-status)
    tmux_running "$SESSION" && echo "public daemon: aktif" || echo "public daemon: mati"
    running "$PID_FILE" && echo "public server: aktif (PID $(cat "$PID_FILE"))" || echo "public server: mati"
    running "$TUNNEL_PID_FILE" && echo "public tunnel: aktif (PID $(cat "$TUNNEL_PID_FILE"))" || echo "public tunnel: mati"
    [[ -f "$URL_FILE" ]] && echo "url: $(cat "$URL_FILE")";;
  admin-status)
    tmux_running "$ADMIN_SESSION" && echo "admin: aktif (http://127.0.0.1:8090)" || echo "admin: mati";;
  stop)
    stop_public; stop_admin;;
  status)
    tmux_running "$SESSION" && echo "daemon: aktif (tmux: $SESSION)" || echo "daemon: mati"
    running "$PID_FILE" && echo "server: aktif (PID $(cat "$PID_FILE"))" || echo "server: mati"
    running "$TUNNEL_PID_FILE" && echo "tunnel: aktif (PID $(cat "$TUNNEL_PID_FILE"))" || echo "tunnel: mati"
    tmux_running "$ADMIN_SESSION" && echo "admin: aktif (http://127.0.0.1:8090)" || echo "admin: mati"
    [[ -f "$URL_FILE" ]] && echo "url: $(cat "$URL_FILE")"
    echo "key: gunakan 'tps key show' atau buka 'tps admin'";;
  logs) tail -n 80 "$LOG_FILE" 2>/dev/null || echo "Belum ada log.";;
  update) git -C "$TPS_HOME" pull --ff-only && cp "$TPS_HOME/bin/tps" "$PREFIX/bin/tps" && cp "$TPS_HOME/bin/tps-public" "$PREFIX/bin/tps-public" && cp "$TPS_HOME/bin/tps-admin" "$PREFIX/bin/tps-admin" && chmod 755 "$PREFIX/bin/tps" "$PREFIX/bin/tps-public" "$PREFIX/bin/tps-admin";;
  uninstall) "$0" stop >/dev/null 2>&1 || true; rm -f "$PREFIX/bin/tps" "$PREFIX/bin/tps-public" "$PREFIX/bin/tps-admin"; echo "CLI dihapus. Data tetap ada di $TPS_HOME.";;
  help|*) echo "Penggunaan: tps start --public|--lan [--foreground] | admin | key show|generate | stop | status | logs | update | uninstall";;
esac
