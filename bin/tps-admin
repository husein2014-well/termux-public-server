#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

usage(){
  cat <<'EOF'
Jalankan halaman admin lokal di http://127.0.0.1:8090

  tps-admin start
  tps-admin stop
  tps-admin status
  tps-admin key show
  tps-admin key info
  tps-admin key generate [durasi]
  tps-admin key set-expiry [durasi]
EOF
}

case "${1:-help}" in
  start) exec "${PREFIX:-}/bin/tps" admin;;
  stop) exec "${PREFIX:-}/bin/tps" admin-stop;;
  status) exec "${PREFIX:-}/bin/tps" admin-status;;
  key) shift; exec "${PREFIX:-}/bin/tps" key "${1:-show}" "${2:-}";;
  help|*) usage;;
esac
